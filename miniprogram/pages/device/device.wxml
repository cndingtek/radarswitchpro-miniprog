<view class="container safe-area-btm bg-main-gradient">
  
  <!-- Lock Status Card -->
  <view class="card bg-secondary-system-background">
    <view class="card-header">
      <text class="card-title typ-title3 text-label">只读模式</text>
      <view class="lock-toggle">
        <view class="toggle-btn {{!isEditable ? 'active' : ''}}" bindtap="setReadOnly">只读</view>
        <view class="toggle-btn {{isEditable ? 'active' : ''}}" bindtap="setEditable">可编辑</view>
      </view>
    </view>
    <view class="lock-status">
      <ui-status iconType="{{isEditable ? 'info' : 'warn'}}" size="16" color="{{isEditable ? theme.primary : theme.gray}}" text="{{isEditable ? '已解锁 • 现在可编辑' : '已锁定 • 仅查看，不能编辑'}}" />
    </view>
  </view>

  <!-- Distance Settings -->
  <view class="card bg-secondary-system-background">
    <text class="card-title typ-title3 text-label">感应距离 (米)</text>
    
    <!-- Custom Multi-Slider -->
    <view class="slider-wrapper">
      <view class="values-row">
        <block wx:if="{{hardwareType === 'modelA'}}">
          <text class="text-secondary-label typ-caption1">最小: {{params.range1}}m</text>
          <text class="text-secondary-label typ-caption1">最大: {{params.range2}}m</text>
        </block>
        <block wx:else>
          <text class="text-secondary-label typ-caption1">近: {{params.range1}}m</text>
          <text class="text-secondary-label typ-caption1">中: {{params.range2}}m</text>
          <text class="text-secondary-label typ-caption1">远: {{params.range3}}m</text>
        </block>
      </view>

      <multi-slider 
        wx:if="{{hardwareType === 'modelA'}}"
        mode="modelA"
        values="{{[params.range1, params.range2]}}"
        min="0" max="10"
        disabled="{{!isEditable}}"
        bindchange="onSliderChange"
      />
      
      <multi-slider 
        wx:else
        mode="modelB"
        values="{{[params.range1, params.range2, params.range3]}}"
        min="0" max="10"
        disabled="{{!isEditable}}"
        bindchange="onSliderChange"
      />
    </view>
  </view>

  <!-- Advanced Settings -->
  <view class="card bg-secondary-system-background">
    <text class="card-title typ-title3 text-label">高级设置</text>
    
    <view class="input-row">
      <text class="label typ-callout text-secondary-label">{{hardwareType === 'modelA' ? '延迟时间' : '离开延迟 (秒)'}}</text>
      <input type="number" value="{{params.exitDelay}}" disabled="{{!isEditable}}" bindinput="onExitDelayChange" class="input"/>
    </view>
    
    <view class="input-row" wx:if="{{hardwareType !== 'modelA'}}">
      <text class="label typ-callout text-secondary-label">触发灵敏度</text>
      <input type="number" value="{{params.sensitivity}}" disabled="{{!isEditable}}" bindinput="onSensitivityChange" class="input"/>
    </view>
  </view>

  <!-- Action Buttons -->
  <view class="action-buttons" wx:if="{{isEditable}}">
    <view style="flex: 1;">
      <ui-button type="custom" text="恢复出厂" bindtap="restoreSettings" />
    </view>
    <view style="flex: 1;">
      <ui-button type="primary" text="保存设置" bindtap="saveSettings" />
    </view>
  </view>

  <!-- Logs -->
  <view class="card logs-card bg-secondary-system-background">
    <text class="card-title typ-title3 text-label">日志</text>
    <scroll-view scroll-y class="logs-container">
      <view wx:for="{{logs}}" wx:key="index" class="log-item">{{item}}</view>
    </scroll-view>
  </view>
  
  <!-- Copyright Info -->
  <view class="footer-info" style="text-align: left; margin-top: 40rpx; margin-bottom: 40rpx; padding-left: 32rpx;">
      <text class="text-secondary-label typ-caption2" style="display: block; margin-bottom: 8rpx;">版本号：V1.1.2</text>
      <text class="text-secondary-label typ-caption2" style="display: block; margin-bottom: 20rpx;">版权所有：2026 北京鼎恒泰科技有限公司</text>
      <image src="/images/wechat.png" style="width: 160rpx; height: 160rpx;" show-menu-by-longpress></image>
  </view>
</view>
