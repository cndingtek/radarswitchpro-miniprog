.container {
  padding: 20rpx;
  background-color: #000;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.card {
  background-color: #1c1c1e;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 20rpx;
}

.lock-toggle {
  display: flex;
  background-color: #2c2c2e;
  border-radius: 12rpx;
  padding: 4rpx;
}

.toggle-btn {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #888;
  border-radius: 8rpx;
}

.toggle-btn.active {
  background-color: #007aff;
  color: #fff;
}

.lock-status {
  display: flex;
  align-items: center;
}

.status-text {
  font-size: 24rpx;
  color: #888;
  margin-left: 10rpx;
}

.slider-row {
  margin-bottom: 30rpx;
}

.slider-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.label {
  font-size: 28rpx;
  color: #ccc;
}

.value {
  font-size: 28rpx;
  color: #007aff;
  font-weight: bold;
}

.input-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #333;
}

.input {
  text-align: right;
  color: #fff;
  width: 100rpx;
}

.action-buttons {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn {
  width: 100%;
  border-radius: 16rpx;
}

.btn-primary {
  background-color: #007aff;
  color: #fff;
}

.btn-danger {
  background-color: #ff3b30;
  color: #fff;
}

.logs-card {
  margin-top: 30rpx;
}

.logs-container {
  height: 300rpx;
  background-color: #000;
  border-radius: 8rpx;
  padding: 10rpx;
  margin-top: 20rpx;
}

.log-item {
  font-size: 20rpx;
  color: #0f0;
  font-family: monospace;
  margin-bottom: 4rpx;
}
