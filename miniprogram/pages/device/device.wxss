.container {
  padding: 32rpx;
  background-color: #000;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.card {
  background-color: #0C2343;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.35);
  border: 1rpx solid #3A3A3C;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  color: #fff;
  display: block;
  margin-bottom: 20rpx;
}

.lock-toggle {
  display: flex;
  background-color: #2c2c2e;
  border-radius: 12rpx;
  padding: 4rpx;
}

.toggle-btn {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #D1D1D6;
  border-radius: 12rpx;
  background-color: #3A3A3C;
}

.toggle-btn.active {
  background-color: #0A84FF;
  color: #fff;
}

.lock-status {
  display: flex;
  align-items: center;
}

.status-text {
  color: #9BA7C8;
  margin-left: 10rpx;
}

.slider-wrapper {
  padding: 20rpx 0;
}

.values-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.label {
  color: #ccc;
}

.input-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #333;
}

.input {
  text-align: right;
  color: #fff;
  width: 100rpx;
}

.action-buttons {
  margin-top: 40rpx;
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.logs-card {
  margin-top: 30rpx;
}

.logs-container {
  height: 300rpx;
  background-color: #0C2343;
  border-radius: 8rpx;
  padding: 10rpx;
  margin-top: 20rpx;
}

.log-item {
  font-size: 20rpx;
  color: #9BA7C8;
  font-family: monospace;
  margin-bottom: 4rpx;
}
