.container {
  padding: 20rpx;
  background-color: #000;
  min-height: 100vh;
}

.list-group {
  background-color: #1c1c1e;
  border-radius: 16rpx;
  overflow: hidden;
  margin-top: 20rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #333;
}

.list-item:last-child {
  border-bottom: none;
}

.item-label {
  color: #fff;
  font-size: 32rpx;
}

.item-value {
  color: #888;
  font-size: 28rpx;
}

.footer {
  margin-top: 60rpx;
  text-align: center;
  color: #666;
  font-size: 24rpx;
}
