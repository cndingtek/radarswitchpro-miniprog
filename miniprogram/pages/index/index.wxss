.container {
  padding: 32rpx;
  background-color: #000;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  color: #fff;
}

.loading {
  color: #888;
}

.device-list {
  width: 100%;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
  color: #888;
}

.scan-btn { display: none; }

.device-item {
  padding: 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.device-info {
  display: flex;
  flex-direction: column;
}

.device-name {
  color: #fff;
  margin-bottom: 8rpx;
}

.device-id {
  color: #888;
  margin-bottom: 4rpx;
}

.device-rssi {
  color: #666;
}

.connect-btn {
  background-color: #2c2c2e;
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #0A84FF;
}
