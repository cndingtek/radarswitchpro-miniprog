<view class="container safe-area-btm bg-main-gradient">
  <view class="header">
    <text class="title typ-title2 text-label">我的设备</text>
    <view class="loading" wx:if="{{isScanning}}">
      <text class="typ-footnote text-secondary-label">扫描中...</text>
    </view>
  </view>

  <view class="device-list">
    <block wx:if="{{devices.length === 0}}">
      <view class="empty-state">
        <text class="typ-callout text-secondary-label">未发现设备</text>
        <ui-button type="primary" size="md" text="重新扫描" bindtap="startScan" />
      </view>
    </block>
    
    <block wx:else>
      <view class="device-item card bg-secondary-system-background" wx:for="{{devices}}" wx:key="deviceId" data-id="{{item.deviceId}}" bindtap="connectDevice">
        <view class="device-info">
          <text class="device-name typ-subheadline text-label">{{item.name || 'Unknown Device'}}</text>
          <text class="device-id typ-caption2 text-secondary-label">UUID: {{item.deviceId}}</text>
          <text class="device-rssi typ-caption2 text-secondary-label">RSSI: {{item.RSSI}}</text>
        </view>
        <ui-button type="primary" size="sm" text="连接" />
      </view>
    </block>
  </view>

  <!-- ICP Placeholder -->
  <view class="footer-icp" style="text-align: center; margin-top: 60rpx; padding-bottom: 40rpx;">
      <text class="text-secondary-label typ-caption2">小程序备案号的占位符</text>
  </view>
</view>
