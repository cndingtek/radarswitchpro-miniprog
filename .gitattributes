* text=auto

# Normalize LF for source files
*.kt   text eol=lf
*.kts  text eol=lf
*.java text eol=lf
*.xml  text eol=lf
*.gradle text eol=lf
*.pro  text eol=lf
*.md   text eol=lf

# Treat binaries as binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.apk  binary
*.aab  binary
*.jar  binary